# ---- Algemeen ----
# simulate = alles draait in een sandbox met gesimuleerde resultaten (geen echte uitgaven)
# live     = echte API-calls naar Meta / Google Ads / LinkedIn
ADAGENT_MODE=simulate
ADAGENT_DB_URL=sqlite:///adagent.db
ADAGENT_TIMEZONE=Europe/Amsterdam
ADAGENT_DAILY_HOUR=7
ADAGENT_CURRENCY=EUR

# ---- Guardrails ----
# Maximale budgetwijziging per campagne per dag (fractie)
ADAGENT_MAX_DAILY_BUDGET_CHANGE=0.2
# Dagen zonder ingrepen na lancering (leerfase)
ADAGENT_LEARNING_DAYS=3
# Maximaal aantal nieuwe advertentievarianten per klant per dag
ADAGENT_MAX_NEW_ADS_PER_DAY=4

# ---- Claude (AI-analyse, copy, beslissingen) ----
# Zonder key draait de agent op de ingebouwde regels + templates.
ANTHROPIC_API_KEY=
ADAGENT_MODEL=claude-opus-5-5
ADAGENT_EFFORT=high

# ---- Meta (Facebook/Instagram) Marketing API ----
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# ---- Google Ads API ----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC (manager) account-ID zonder streepjes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v21

# ---- LinkedIn Marketing API ----
LINKEDIN_ACCESS_TOKEN=
# Formaat YYYYMM
LINKEDIN_API_VERSION=202510
